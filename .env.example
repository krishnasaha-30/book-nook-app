# Express API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# BetterAuth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# MongoDB (BetterAuth collections)
MONGODB_URI=

# Google social login (optional; button is hidden unless both are set)
# Google OAuth callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImgBB (required for book cover uploads; the key stays on the server)
IMGBB_API_KEY=
